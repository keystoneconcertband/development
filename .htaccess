# Deny direct access to hidden/dot files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Deny direct access to dependency manifests and documentation
<FilesMatch "^(composer\.(json|lock)|package\.json|yarn\.lock|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Deny direct access to sensitive extensions
<FilesMatch "\.(ini|log|sql|sh|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Health check endpoint alias for Apache environments (e.g. local Docker LAMP)
# NOTE: Azure App Service (Linux) runs on Nginx and does not process .htaccess files.
# Direct requests to extensionless /health will 404 on Azure; use /health.php or /api/health.php.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^health/?$ health.php [L,QSA]
</IfModule>


